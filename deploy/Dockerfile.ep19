# EP-1-9 verification image: skips the console-builder stage (the
# local console/dist is copied in) and desktop/Chromium layers. Not
# used for production builds — see scripts/docker_build.sh.
ARG NODE_IMAGE=agentscope-registry.ap-southeast-1.cr.aliyuncs.com/agentscope/node:slim
FROM ${NODE_IMAGE}

ENV NODE_ENV=production
ENV WORKSPACE_DIR=/app
ENV QWENPAW_WORKING_DIR=/app/working
ENV QWENPAW_SECRET_DIR=/app/working.secret
ENV QWENPAW_BACKUP_DIR=/app/working.backups
ENV QWENPAW_DISABLED_CHANNELS=imessage
ENV QWENPAW_RUNNING_IN_CONTAINER=1

# Intranet-friendly apt mirror (default deb.debian.org is unreachable
# from this network); harmless no-op where the mirror already matches.
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/*.sources 2>/dev/null; \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null; true

RUN apt-get update && apt-get install -y --fix-missing \
    curl python3 python3-pip python3-venv build-essential \
    libssl-dev git supervisor vim gettext-base \
  && rm -rf /var/lib/apt/lists/* && apt-get clean

WORKDIR ${WORKSPACE_DIR}
RUN python3 -m venv venv
ENV PATH="/app/venv/bin:$PATH"

COPY pyproject.toml setup.py README.md ./
COPY src ./src
COPY packages/qwenpawmail-mcp/src/qwenpawmail_mcp ./packages/qwenpawmail-mcp/src/qwenpawmail_mcp
COPY website/public/docs/ ./src/qwenpaw/docs/
# console/dist is copied into src/qwenpaw/console/ before building
# (see .dockerignore: console/dist is ignored, src/.../dist is not).
RUN pip install --no-cache-dir . "setuptools<82" && rm -rf ./build

ENV QWENPAW_PORT=8088
COPY deploy/config/supervisord.conf.template /etc/supervisor/conf.d/supervisord.conf.template
COPY --chmod=755 deploy/entrypoint.sh /entrypoint.sh

EXPOSE 8088
